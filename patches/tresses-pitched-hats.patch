diff --git a/src/tresses-dsp.adb b/src/tresses-dsp.adb
index a85441b..9fb4dd9 100644
--- a/src/tresses-dsp.adb
+++ b/src/tresses-dsp.adb
@@ -171,6 +171,47 @@ package body Tresses.DSP is
       return To_S32 (To_U32 (A) and B);
    end "and";
 
+   -----------------
+   -- Sample_Step --
+   -----------------
+
+   function Sample_Step (Pitch : Pitch_Range) return U32 is
+
+      Semi_Ratio : constant array (0 .. 12) of U32 :=
+        (256, 271, 287, 304, 323, 342, 362, 384, 406, 431, 456, 483, 512);
+      --  2**(N/12) in 8.8 fixed point, one octave. Anything outside this
+      --  octave is the same ratio shifted.
+
+      Max_Octaves : constant := 4;
+      --  Past this the step is either grinding through one frame at a time
+      --  or skipping most of the sample, neither of which is musical, and
+      --  clamping keeps the shifts below from running off either end.
+
+      Rel : constant Integer := Integer (Pitch) - Sample_Unity_Pitch;
+
+      --  Ada's mod is floored, so this remainder is always 0 .. 127 and the
+      --  matching division floors too, which is what negative pitches need.
+      Frac : constant Integer := Rel mod 128;
+      Semi : constant Integer :=
+        Integer'Max (-Max_Octaves * 12,
+                     Integer'Min (Max_Octaves * 12, (Rel - Frac) / 128));
+
+      Note : constant Integer := Semi mod 12;
+      Oct  : constant Integer := (Semi - Note) / 12;
+
+      Lo : constant U32 := Semi_Ratio (Note);
+      Hi : constant U32 := Semi_Ratio (Note + 1);
+
+      Ratio : constant U32 := Lo + ((Hi - Lo) * U32 (Frac)) / 128;
+   begin
+      if Oct >= 0 then
+         return Ratio * 2**Oct;
+      else
+         --  Never zero, or the read would sit on one frame forever.
+         return U32'Max (1, Ratio / 2**(-Oct));
+      end if;
+   end Sample_Step;
+
