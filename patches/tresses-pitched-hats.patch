    -- Compute_Phase_Increment --
    -----------------------------
diff --git a/src/tresses-dsp.ads b/src/tresses-dsp.ads
index e169576..cca3126 100644
--- a/src/tresses-dsp.ads
+++ b/src/tresses-dsp.ads
@@ -60,6 +60,22 @@ is
    function "and" (A : S32; B : U32) return S32
      with Inline_Always;
 
+   Sample_Unity_Pitch : constant := 60 * 128;
+   --  C4, the key at which a sample plays back at its own recorded rate.
+   --  Matches the samplers, so a pitched sample-playback voice agrees with
+   --  them about which note is unity.
+
+   function Sample_Step (Pitch : Pitch_Range) return U32
+     with Linker_Section => Code_Linker_Section;
+   --  How far to advance through a sample per read, as a frame count with 8
+   --  fractional bits. 256 is the sample's own rate, which is what C4 gives.
+   --  A caller that reads one frame per several output samples already plays
+   --  slower by doing that, so it wants this same value, not a scaled one.
+   --
+   --  Uses a one-octave table of semitone ratios with the octave applied as
+   --  a shift, and interpolates across the semitone for bend, so there is no
+   --  per-note table and no floating point.
+
    function Compute_Phase_Increment (Pitch : S16) return U32
      with Linker_Section => Code_Linker_Section;
 
