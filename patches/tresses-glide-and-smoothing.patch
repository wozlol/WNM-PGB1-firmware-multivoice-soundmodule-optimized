+         Amount := Param_Range'Last - Param_Range
+           (if Glide_Full_Resolution
+            then Value (Shape_Env)
+            else LoFi (Shape_Env));
          Current_Phase_Incr :=
            Start_Phase_Incr - DSP.Modulate (Diff, Amount);
       end if;
@@ -112,7 +118,10 @@ package body Tresses.Voices.Chip_Portamento is
          Sample := Filters.SVF.Process (Filter, Sample);
 
          --  Sample := (Sample * Low_Pass (Env)) / 2**15;
-         Sample := (Sample * S32 (LoFi (Env))) / 2**15;
