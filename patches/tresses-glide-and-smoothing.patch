diff --git a/src/tresses.ads b/src/tresses.ads
index 56f0600..12a35da 100644
--- a/src/tresses.ads
+++ b/src/tresses.ads
@@ -37,6 +37,13 @@ is
    type Param_Id is range 1 .. 4;
    type Param_Array is array (Param_Id) of Param_Range;
 
+   Glide_Full_Resolution : Boolean := False;
+   --  Set by the application. The glide engines originally derived their
+   --  portamento amount from LoFi of the shape envelope, which keeps only
+   --  5 bits and so moves the pitch in 32 steps. That coarseness is part
+   --  of their character, so it stays the default and this switches it to
+   --  the full value instead.
+
    type Pitch_Range is new S16 range 0 .. 127 * 128;
 
    function Add_Sat (A, B : Pitch_Range) return Pitch_Range;
