diff --git a/src/tresses-voices-chip_echo.adb b/src/tresses-voices-chip_echo.adb
index 0cb3dc3..a746cd7 100644
--- a/src/tresses-voices-chip_echo.adb
+++ b/src/tresses-voices-chip_echo.adb
@@ -130,8 +130,11 @@ package body Tresses.Voices.Chip_Echo is
          Render (Env1);
          Render (Env2);
 
-         SampleA := (SampleA * S32 (LoFi (Env1))) / 2**15;
-         SampleB := (SampleB * S32 (LoFi (Env2))) / 2**15;
+         --  Envelope amplitude at full resolution. LoFi masks off the low
+         --  11 bits, leaving 32 amplitude levels, so a fade descends in
+         --  jumps of 6.25% of full scale and each jump is an audible step.
+         SampleA := (SampleA * Low_Pass (Env1)) / 2**15;
+         SampleB := (SampleB * Low_Pass (Env2)) / 2**15;
          BufferA (Index) := S16 ((SampleA + SampleB) / 2);
       end loop;
 
diff --git a/src/tresses-voices-chip_phaser.adb b/src/tresses-voices-chip_phaser.adb
index 8b54d32..ce02846 100644
--- a/src/tresses-voices-chip_phaser.adb
+++ b/src/tresses-voices-chip_phaser.adb
@@ -54,6 +54,12 @@ package body Tresses.Voices.Chip_Phaser is
          when None => null;
       end case;
 
+      --  Recomputed every render, not just on the strike, so a pitch
+      --  change part way through a note (a pitch bend) is actually heard.
+      --  Latching it at the strike meant Set_Pitch had no effect until the
+      --  next note.
+      Phase_Increment := DSP.Compute_Phase_Increment (S16 (Pitch));
+
       Analog_Oscillator.Set_Param (Osc1, 0, Shape);
       Analog_Oscillator.Render (Osc1, BufferA, Phase_Increment);
       Analog_Oscillator.Set_Param (Osc2, 0, Shape);
@@ -70,7 +76,13 @@ package body Tresses.Voices.Chip_Phaser is
          --  Envolopes
          Render (Env);
          SampleA := (SampleA + SampleB) / 2;
-         SampleA := (SampleA * S32 (LoFi (Env))) / 2**15;
+         --  Was LoFi (Env), which masks off the low 11 bits of the
+         --  envelope and so leaves only 32 amplitude levels. A fade then
+         --  descends in 32 jumps of 6.25% of full scale, and every jump is
+         --  an abrupt step, so a long release turns into a staircase of
+         --  clicks and a short one into a single pop. The sibling engine
+         --  Wave_Phaser uses Low_Pass here and is clean, so match it.
+         SampleA := (SampleA * Low_Pass (Env)) / 2**15;
          BufferA (Index) := S16 (SampleA);
       end loop;
 
