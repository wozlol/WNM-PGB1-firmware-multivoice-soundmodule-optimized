+            Phase_Increment := Target_Phase_Increment;
          end if;
 
          Phase := Phase + Phase_Increment;
diff --git a/src/tresses-voices-pluck_bass.adb b/src/tresses-voices-pluck_bass.adb
index 19d0648..3c77ee3 100644
--- a/src/tresses-voices-pluck_bass.adb
+++ b/src/tresses-voices-pluck_bass.adb
@@ -70,6 +70,12 @@ package body Tresses.Voices.Pluck_Bass is
          when None => null;
       end case;
 
+      --  Recomputed every render, not just on the strike, so a pitch
+      --  change part way through a note (a pitch bend) is actually heard.
+      --  Latching it at the strike meant Set_Pitch had no effect until the
+      --  next note.
+      Phase_Increment := DSP.Compute_Phase_Increment (S16 (Pitch));
+
       for Index in Buffer'Range loop
 
          Phase := Phase + Phase_Increment;
