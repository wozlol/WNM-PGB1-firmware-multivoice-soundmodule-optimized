diff --git a/src/tresses-drums-wave_kick.adb b/src/tresses-drums-wave_kick.adb
index 961c554..2d3e4f1 100644
--- a/src/tresses-drums-wave_kick.adb
+++ b/src/tresses-drums-wave_kick.adb
@@ -79,14 +79,31 @@ package body Tresses.Drums.Wave_Kick is
       Drive_Amount := Shift_Right (Drive_Amount**2, 15);
       Drive_Amount := Drive_Amount * 2;
 
-      Phase_Incr_Delta := (Phase_Increment - Target_Phase_Increment) /
-        (Resources.SAMPLE_RATE / (1 +
-         (U32 (Param_Range'Last - Pitch_Decay)) / 259));
+      --  Retune the destination pitch every render, not only at the
+      --  strike, so a bend applied while the note is sounding is heard.
+      --  Phase_Increment itself is left alone because it is mid-sweep, so
+      --  the pitch drop these engines are built on still behaves.
+      Target_Phase_Increment := DSP.Compute_Phase_Increment (S16 (Pitch));
+
+      if Phase_Increment > Target_Phase_Increment then
+         Phase_Incr_Delta := (Phase_Increment - Target_Phase_Increment) /
+           (Resources.SAMPLE_RATE / (1 +
+            (U32 (Param_Range'Last - Pitch_Decay)) / 259));
+      else
+         Phase_Incr_Delta := 0;
+      end if;
 
       for Index in Buffer'Range loop
 
+         --  The drop only ever descends from above the target, so keep
+         --  that sweep as it was. If a bend has moved the target above the
+         --  current increment, follow it straight away: these are U32, so
+         --  the delta computed above would have underflowed, which is why
+         --  the pitch used to stick and never come back up.
          if Phase_Increment > Target_Phase_Increment then
             Phase_Increment := Phase_Increment - Phase_Incr_Delta;
+         elsif Phase_Increment < Target_Phase_Increment then
+            Phase_Increment := Target_Phase_Increment;
          end if;
          Phase := Phase + Phase_Increment;
 
